# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/runserver"

# --- Auth ---
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# --- App URLs ---
WEB_APP_URL=""
API_URL=""

# --- Brevo (email: invites, reminders, receipts) ---
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME=""

# --- Paystack ---
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# --- Flutterwave ---
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_PUBLIC_KEY=""
# Static secret hash you set in the Flutterwave dashboard's webhook config —
# Flutterwave echoes this back in the `verif-hash` header on every webhook,
# unlike Paystack which HMAC-signs the body.
FLUTTERWAVE_WEBHOOK_SECRET_HASH=""

# --- Admin (RunServer staff, not client-org users) ---
ADMIN_JWT_SECRET=""
# Used only by prisma/seed.ts to create your first admin login
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- Free cron trigger (Render's own Cron Jobs require a paid plan) ---
# Shared secret checked on /internal/jobs/* — an external free scheduler
# (Vercel Cron, cron-job.org, GitHub Actions) calls these with this header.
CRON_SECRET=""

# --- Server ---
PORT=4000
NODE_ENV="development"
